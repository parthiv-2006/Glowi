# Copy to .env and fill in. EXPO_PUBLIC_* vars are bundled into the app —
# only ever put publishable values here. Secrets live in edge function config.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# "live" calls the deployed edge functions (requires ANTHROPIC_API_KEY secret
# set on the Supabase project). "mock" runs the full app offline with
# realistic simulated AI — perfect for demos. Toggleable at runtime in
# Profile → Developer too.
EXPO_PUBLIC_AI_MODE=mock
