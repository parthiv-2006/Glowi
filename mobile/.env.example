# Copy to .env and fill in. EXPO_PUBLIC_* vars are bundled into the app —
# only ever put publishable values here. Secrets live in edge function config.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# "live" (the default) calls the deployed edge functions (requires
# ANTHROPIC_API_KEY secret set on the Supabase project). "mock" runs the full
# app offline with realistic simulated AI — the offline/demo mode, zero token
# cost. Toggleable at runtime in Profile → Developer too.
#
# ⚠️ aiMode is persisted in AsyncStorage (zustand `persist`, store name
# glowi-settings) once a device has launched the app. Editing this file only
# seeds the *first* launch — it will NOT flip an existing install. To force a
# device back to this default, clear the app's storage or toggle it in
# Profile → Developer.
EXPO_PUBLIC_AI_MODE=live
