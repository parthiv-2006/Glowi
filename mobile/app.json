{
  "expo": {
    "name": "Glowi",
    "slug": "glowi",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "glowi",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#15110E",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.glowi.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Glowi lets you pick an existing photo of a skin concern for AI analysis."
      }
    },
    "android": {
      "package": "com.glowi.app",
      "adaptiveIcon": {
        "backgroundColor": "#15110E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Glowi uses the camera to photograph skin concerns for AI analysis."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15110E",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 120
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2DD4BF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
