{
  "expo": {
    "name": "Glowi",
    "slug": "glowi",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "glowi",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#15110E",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.glowi.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Glowi lets you pick an existing photo of a skin concern for AI analysis."
      }
    },
    "android": {
      "package": "com.glowi.app",
      "adaptiveIcon": {
        "backgroundColor": "#15110E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.health.READ_SLEEP"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Glowi uses the camera to photograph skin concerns for AI analysis.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15110E",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 120
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2DD4BF"
        }
      ],
      "expo-sharing",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Glowi reads last night's sleep from Health to pre-fill your daily check-in. You confirm every value before it's saved.",
          "NSHealthUpdateUsageDescription": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "049c9cf2-9aa9-42c0-854a-ad20a5a80b55"
      }
    },
    "owner": "parthiv-2006s-team"
  }
}
