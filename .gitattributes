# Normalize line endings: LF in the repo, native in the working tree.
* text=auto

# Binary assets — never diff or normalize
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Shell scripts must stay LF regardless of platform
*.sh text eol=lf
